# Copy to .env — never commit .env to version control

# PostgreSQL
DB_PASSWORD=change_me_strong_db_password

# JWT signing key for agent tokens — min 32 chars, random
JWT_SECRET=change_me_to_a_random_min_32_char_secret_string

# Dashboard superadmin password
SUPER_ADMIN_PASSWORD=Admin@1234!

# Your public domain (Caddy uses this for auto-TLS)
DOMAIN=monitor.yourdomain.com

# Public URL — used in agent download packages (the URL agents connect to)
PUBLIC_URL=http://185.218.126.64

# .NET version — must match Directory.Build.props DotNetVersion
DOTNET_VERSION=10.0
