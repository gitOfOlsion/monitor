<Window x:Class="PeripheralMonitor.Client.Wpf.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Activity" Height="600" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="#1a1a2e"/>
            <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#888" Margin="0,2,0,8"/>

            <!-- Tabs -->
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabActivity" Content="📋  Activity Log"
                             IsChecked="True" Checked="Tab_Changed"
                             Style="{StaticResource {x:Type RadioButton}}"
                             Padding="14,6" Margin="0,0,4,0"
                             Background="#1a1a2e" Foreground="White"/>
                <RadioButton x:Name="TabConnected" Content="🖥️  Connected Devices"
                             Checked="Tab_Changed"
                             Padding="14,6"
                             Background="#e0e0e0"/>
            </StackPanel>
        </StackPanel>

        <!-- TAB 1: Activity Log (TreeView grouped) -->
        <Grid x:Name="PanelActivity" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="FilterBox" Width="180" Padding="6,4"
                         TextChanged="FilterBox_TextChanged" BorderBrush="#ccc"/>
                <ComboBox x:Name="EventTypeFilter" Margin="8,0,0,0" Width="130" Padding="6,4"
                          SelectionChanged="EventTypeFilter_Changed">
                    <ComboBoxItem Content="All Events" IsSelected="True"/>
                    <ComboBoxItem Content="Connected"/>
                    <ComboBoxItem Content="Disconnected"/>
                </ComboBox>
                <TextBlock x:Name="CountText" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="#888" FontSize="11"/>
            </StackPanel>

            <!-- TreeView: grouped by logical device -->
            <TreeView x:Name="ActivityTree" Grid.Row="1"
                      BorderBrush="#ddd" BorderThickness="1"
                      Background="White" FontSize="12">
                <TreeView.Resources>
                    <!-- Group header style -->
                    <Style x:Key="GroupHeader" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Padding" Value="4,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <!-- TAB 2: Connected Devices -->
        <Grid x:Name="PanelConnected" Grid.Row="1" Visibility="Collapsed">
            <DataGrid x:Name="ConnectedGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F0F2FF"
                      RowBackground="White"
                      BorderBrush="#ddd" BorderThickness="1"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category"    Binding="{Binding Category}"    Width="110"/>
                    <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}"  Width="*"/>
                    <DataGridTextColumn Header="Last Seen"   Binding="{Binding LastSeen, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="145"/>
                    <DataGridTextColumn Header="Events"      Binding="{Binding TotalEvents}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="🔄 Refresh" Click="Refresh_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Close"      Click="Close_Click"   Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>