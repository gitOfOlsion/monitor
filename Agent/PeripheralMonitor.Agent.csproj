<Project Sdk="Microsoft.NET.Sdk.Worker">
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"             Version="$(AspNetCoreVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting"                    Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices"   Version="$(ExtensionsVersion)" />
    <PackageReference Include="System.Management"                               Version="$(ExtensionsVersion)" />
    <PackageReference Include="Serilog.Extensions.Hosting"                      Version="$(SerilogHostingVersion)" />
    <PackageReference Include="Serilog.Sinks.Console"                           Version="$(SerilogConsoleVersion)" />
    <PackageReference Include="Serilog.Sinks.File"                              Version="$(SerilogFileVersion)" />
    <PackageReference Include="Serilog.Sinks.Seq"                               Version="$(SerilogSeqVersion)" />
    <PackageReference Include="Serilog.Settings.Configuration"                  Version="$(SerilogConfigVersion)" />
    <PackageReference Include="Serilog.Enrichers.Environment"                   Version="$(SerilogEnvVersion)" />
  </ItemGroup>

  <!-- Exclude platform-specific source files when cross-compiling -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' OR '$(RuntimeIdentifier)' == 'linux-arm64'">
    <Compile Remove="WindowsDeviceMonitor.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == 'win-arm64'">
    <Compile Remove="LinuxDeviceMonitor.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\PeripheralMonitor.Shared.csproj" />
  </ItemGroup>
</Project>
