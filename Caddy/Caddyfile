# Production Caddyfile for monitorhubs.net
# Caddy auto-provisions TLS via Let's Encrypt on port 443
# Ports 80 and 443 must be open on your firewall

# Redirect www → apex
www.monitorhubs.net {
    redir https://monitorhubs.net{uri} permanent
}

monitorhubs.net {

    # Blazor Server dashboard (default — everything not matched below)
    @web {
        not path /api/* /monitor /monitor/* /health /seq/* /remote /remote/*
    }
    handle @web {
        reverse_proxy web:5001
    }

    # Server REST API
    handle /api/* {
        reverse_proxy server:5000
    }

    # SignalR hub — agents + web dashboard (WebSocket upgrade required)
    handle /monitor* {
        reverse_proxy server:5000 {
            header_up Upgrade    {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
            header_up Host       {host}
            header_up X-Real-IP  {remote_host}
        }
    }

    handle /health {
        reverse_proxy server:5000
    }

    # Guacamole remote desktop gateway
    handle /remote {
        redir /remote/ 308
    }
    handle_path /remote/* {
        rewrite * /guacamole{uri}
        reverse_proxy guacamole:8080
    }

    # Seq log viewer
    handle /seq/* {
        uri strip_prefix /seq
        reverse_proxy seq:80
    }

    encode gzip
}
