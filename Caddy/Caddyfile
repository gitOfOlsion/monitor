# ─────────────────────────────────────────────────────────────────────────
# Production configuration for monitorhubs.net
#
# When a domain (not :80) is specified, Caddy automatically:
#   • provisions and renews a TLS certificate via Let's Encrypt
#   • redirects ALL http:// traffic to https:// (HTTP→HTTPS 308 redirect)
# Requirements: DNS A/AAAA record for monitorhubs.net → this host,
#               and ports 80 + 443 reachable from the internet.
# For local/dev use, replace the domain line with ":80".
# ─────────────────────────────────────────────────────────────────────────

# Redirect the www subdomain to the bare apex domain (over HTTPS)
www.monitorhubs.net {
    redir https://monitorhubs.net{uri} permanent
}

monitorhubs.net {

    # Security headers (HTTPS-only is also a search ranking signal)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # Keep machine endpoints and admin tools out of search results
    @noindex path /api/* /monitor /monitor/* /health /seq/* /remote /remote/* /auth/*
    header @noindex X-Robots-Tag "noindex, nofollow"

    # Images and icons: cache for a week. (Scripts are not versioned, so they keep the default.)
    @static path *.svg *.png *.ico *.webmanifest
    header @static Cache-Control "public, max-age=604800"

    # Blazor Server dashboard (default) — everything not matched below
    @web {
        not path /api/* /monitor /monitor/* /health /seq/* /remote /remote/*
    }
    handle @web {
        reverse_proxy web:5001 {
            # Preserve WebSocket upgrades for Blazor Server's SignalR circuit
            header_up Upgrade    {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
        }
    }

    # Server REST API
    handle /api/* {
        reverse_proxy server:5000
    }

    # SignalR hub (agents + web dashboard) — needs explicit WebSocket upgrade headers
    handle /monitor* {
        reverse_proxy server:5000 {
            header_up Upgrade    {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
        }
    }

    handle /health {
        reverse_proxy server:5000
    }

    # Guacamole remote desktop gateway
    # Guacamole's WAR deploys at the /guacamole context path (not root).
    # handle_path strips the matched "/remote" prefix, and we prepend "/guacamole".
    handle /remote {
        redir /remote/ 308
    }
    handle_path /remote/* {
        rewrite * /guacamole{uri}
        reverse_proxy guacamole:8080 {
            # Guacamole uses WebSockets for the remote-desktop tunnel
            header_up Upgrade    {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
        }
    }

    # Seq log viewer
    handle /seq/* {
        uri strip_prefix /seq
        reverse_proxy seq:80
    }

    encode zstd gzip
}
