@page "/users"
@attribute [Authorize(Roles = "SuperAdmin,InstitutionAdmin")]
@inject ServerApiClient Api
@inject AuthenticationStateProvider AuthState
@inject TimeZoneService TZ

<PageTitle>Users — Peripheral Monitor</PageTitle>

<div class="pm-page-header">
    <h1>Users</h1>
    <button class="pm-btn pm-btn-primary" @onclick="() => _showCreate = true">+ New User</button>
</div>

@if (_showCreate)
{
    <div class="pm-modal-overlay" @onclick="() => _showCreate = false">
        <div class="pm-modal" @onclick:stopPropagation>
            <h2>New User</h2>

            @if (_error != null)
            { <div class="pm-alert pm-alert-error">@_error</div> }

            <div class="pm-field"><label>Username</label>
                <input class="pm-input" @bind="_uName" placeholder="jdoe" /></div>
            <div class="pm-field"><label>Email</label>
                <input class="pm-input" @bind="_uEmail" type="email" placeholder="jdoe@institution.edu" /></div>
            <div class="pm-field"><label>Password</label>
                <input class="pm-input" @bind="_uPass" type="password" placeholder="min 8 chars, 1 digit" /></div>
            <div class="pm-field"><label>Role</label>
                <select class="pm-input" @bind="_uRole">
                    <option value="Viewer">Viewer (read-only)</option>
                    <option value="InstitutionAdmin">Institution Admin</option>
                </select>
            </div>

            @if (_isSuperAdmin)
            {
                <div class="pm-field"><label>Institution</label>
                    <select class="pm-input" @bind="_uInstitution">
                        <option value="">-- select --</option>
                        @foreach (var i in _institutions)
                        { <option value="@i.Id">@i.Name</option> }
                    </select>
                </div>
            }

            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="() => _showCreate = false">Cancel</button>
                <button class="pm-btn pm-btn-primary" @onclick="CreateAsync"
                        disabled="@(!CanCreate)">Create</button>
            </div>
        </div>
    </div>
}

@if (_editUser != null)
{
    <div class="pm-modal-overlay" @onclick="CloseEdit">
        <div class="pm-modal" @onclick:stopPropagation>
            <h2>Edit User — @_editUser.UserName</h2>

            @if (_editError != null)
            { <div class="pm-alert pm-alert-error">@_editError</div> }

            <div class="pm-field"><label>Email</label>
                <input class="pm-input" @bind="_editEmail" type="email" placeholder="user@institution.edu" /></div>
            <div class="pm-field"><label>New Password</label>
                <input class="pm-input" @bind="_editPass" type="password" placeholder="leave blank to keep current" /></div>
            <p class="pm-hint" style="margin:.25rem 0 0 0">Leave the password blank to keep the existing one. Username and role can't be changed here.</p>

            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="CloseEdit">Cancel</button>
                <button class="pm-btn pm-btn-primary" @onclick="SaveEditAsync">Save changes</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{ <div class="pm-loading">Loading…</div> }
else
{
    @foreach (var group in _users.GroupBy(u => u.InstitutionName ?? "System / No Institution").OrderBy(g => g.Key))
    {
        <h3 class="pm-group-header">@group.Key</h3>
        <div class="pm-table-wrapper" style="margin-bottom:1.5rem">
            <table class="pm-table">
                <thead><tr>
                    <th>Username</th><th>Email</th><th>Role</th><th>Created</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var u in group)
                    {
                        <tr>
                            <td data-label="Username"><strong>@u.UserName</strong></td>
                            <td data-label="Email">@u.Email</td>
                            <td data-label="Role"><span class="pm-badge pm-badge-@u.Role.ToLower()">@u.Role</span></td>
                            <td data-label="Created">@Fmt(u.CreatedAt, "yyyy-MM-dd")</td>
                            <td class="pm-actions">
                                <button class="pm-btn pm-btn-secondary pm-btn-sm"
                                        @onclick="() => OpenEdit(u)">✏️ Edit</button>
                                @if (u.Role != "SuperAdmin" &&
                                     !string.Equals(u.UserName, _currentUser, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pm-btn pm-btn-danger pm-btn-sm"
                                            @onclick="() => DeleteAsync(u.Id)">🗑 Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (!_users.Any()) { <div class="pm-empty">No users yet.</div> }
}

@if (_message != null)
{ <div class="pm-toast @(_msgError ? "pm-toast-error" : "pm-toast-success")">@_message</div> }

@code {
    private List<UserDto>        _users        = [];
    private List<InstitutionDto> _institutions = [];
    private bool   _loading = true, _showCreate, _isSuperAdmin, _msgError;
    private string _uName = "", _uEmail = "", _uPass = "", _uRole = "Viewer", _uInstitution = "";
    private string? _error, _message;
    private string  _currentUser = "";
    private TimeSpan _tzOffset = TimeSpan.Zero;
    private bool _tzFetched;

    // Edit modal state
    private UserDto? _editUser;
    private string _editEmail = "", _editPass = "";
    private string? _editError;

    private void OpenEdit(UserDto u)
    {
        _editUser  = u;
        _editEmail = u.Email ?? "";
        _editPass  = "";
        _editError = null;
    }

    private void CloseEdit() { _editUser = null; _editError = null; }

    private async Task SaveEditAsync()
    {
        if (_editUser == null) return;
        _editError = null;
        var (ok, error) = await Api.UpdateUserAsync(_editUser.Id,
            new UpdateUserRequest(string.IsNullOrWhiteSpace(_editEmail) ? null : _editEmail,
                                  string.IsNullOrWhiteSpace(_editPass) ? null : _editPass));
        if (ok)
        {
            CloseEdit();
            Toast("User updated.", false);
            await LoadAsync();
        }
        else { _editError = error; }
    }

    private string Fmt(DateTime utc, string format = "yyyy-MM-dd HH:mm:ss")
        => utc.Add(_tzOffset).ToString(format);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_tzFetched)
        {
            _tzFetched = true;
            _tzOffset = await TZ.GetOffsetAsync();
            StateHasChanged();
        }
    }

    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(_uName) &&
        !string.IsNullOrWhiteSpace(_uPass) &&
        (!_isSuperAdmin || !string.IsNullOrEmpty(_uInstitution));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isSuperAdmin = auth.User.IsInRole("SuperAdmin");
        _currentUser  = auth.User.Identity?.Name ?? "";
        if (_isSuperAdmin)
            _institutions = await Api.GetInstitutionsAsync() ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _users   = await Api.GetUsersAsync() ?? [];
        _loading = false;
    }

    private async Task CreateAsync()
    {
        _error = null;
        Guid? inst = Guid.TryParse(_uInstitution, out var g) ? g : null;
        var req = new CreateUserRequest(_uName, _uEmail, _uPass, _uRole, inst);
        var (ok, error) = await Api.CreateUserAsync(req);
        if (ok)
        {
            _showCreate = false;
            _uName = _uEmail = _uPass = ""; _uRole = "Viewer"; _uInstitution = "";
            Toast("User created.", false);
            await LoadAsync();
        }
        else { _error = error; }
    }

    private async Task DeleteAsync(string id)
    {
        var (ok, error) = await Api.DeleteUserAsync(id);
        Toast(ok ? "User deleted." : (error ?? "Failed."), !ok);
        if (ok) await LoadAsync();
    }

    private void Toast(string msg, bool err)
    {
        _message = msg; _msgError = err;
        _ = Task.Delay(4000).ContinueWith(_ => { _message = null; InvokeAsync(StateHasChanged); });
    }
}
