@page "/features"
@attribute [Authorize(Roles = "SuperAdmin,InstitutionAdmin")]
@using System.Security.Claims
@inject ServerApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Feature Management</PageTitle>

<div class="pm-page-header">
    <h1>@(_isSuperAdmin ? "Feature Management" : "Features")</h1>
</div>

@if (_isSuperAdmin)
{
    <p class="pm-hint" style="margin:0 0 1rem 0">
        Turn features on or off per institution, or override per device. A device setting wins over the
        institution setting; if neither is set, the feature's default applies. Changes take effect immediately.
    </p>
}
else
{
    <div class="pm-readonly-note">
        🔒 This is a read-only view of the features enabled for your institution.
        Changing feature availability is reserved for the system administrator.
    </div>
}

@if (_msg != null)
{
    <div class="pm-alert @(_msgOk ? "pm-alert-success" : "pm-alert-error")" style="margin-bottom:1rem">@_msg</div>
}

@if (_isSuperAdmin)
{
    <div class="pm-features-toolbar">
        <div class="pm-field" style="margin:0">
            <label>Institution</label>
            <select class="pm-input pm-input-sm" @bind="_selectedInstitution" @bind:after="OnInstitutionChanged">
                <option value="">— select institution —</option>
                @foreach (var i in _institutions)
                { <option value="@i.Id">@i.Name</option> }
            </select>
        </div>

        @if (_selectedInstitution != "")
        {
            <div class="pm-field" style="margin:0">
                <label>Scope</label>
                <select class="pm-input pm-input-sm" @bind="_scopeMode" @bind:after="OnScopeChanged">
                    <option value="institution">Whole institution</option>
                    <option value="device">Specific device</option>
                </select>
            </div>

            @if (_scopeMode == "device")
            {
                <div class="pm-field" style="margin:0">
                    <label>Device</label>
                    <select class="pm-input pm-input-sm" @bind="_selectedAgent" @bind:after="LoadFeatures">
                        <option value="">— select device —</option>
                        @foreach (var a in _agents)
                        { <option value="@a.Id">@a.MachineName</option> }
                    </select>
                </div>
            }
        }
    </div>
}

@if (_loading)
{
    <div class="pm-loading">Loading…</div>
}
else if (_features.Count == 0)
{
    <div class="pm-empty">
        @(_isSuperAdmin ? $"Select an institution{(_scopeMode == "device" ? " and device" : "")} to manage features." : "No features to display.")
    </div>
}
else
{
    <div class="pm-feature-list">
        @foreach (var f in _features)
        {
            <div class="pm-feature-card">
                <div class="pm-feature-icon">@f.Icon</div>
                <div class="pm-feature-body">
                    <div class="pm-feature-name">
                        @f.Name
                        <span class="pm-feature-effective @(f.Effective ? "on" : "off")">
                            @(f.Effective ? "ENABLED" : "DISABLED")
                        </span>
                    </div>
                    <div class="pm-feature-desc">@f.Description</div>
                    <div class="pm-feature-inherit">
                        @if (_isSuperAdmin && _scopeMode == "device")
                        {
                            <span>Institution: <strong>@StateLabel(f.InstitutionEnabled, f.DefaultEnabled)</strong></span>
                            @if (f.AgentEnabled.HasValue)
                            { <span class="pm-feature-override">· device override active</span> }
                        }
                        else if (_isSuperAdmin)
                        {
                            <span>Default: <strong>@(f.DefaultEnabled ? "On" : "Off")</strong></span>
                        }
                    </div>
                </div>
                @if (_isSuperAdmin)
                {
                    <div class="pm-feature-controls">
                        @{
                            bool? currentOverride = _scopeMode == "device" ? f.AgentEnabled : f.InstitutionEnabled;
                        }
                        <select class="pm-input pm-input-sm" value="@OverrideValue(currentOverride)"
                                @onchange="@(e => SetFeature(f, e.Value?.ToString()))">
                            <option value="inherit">@(_scopeMode == "device" ? "Inherit from institution" : "Use default")</option>
                            <option value="on">Force ON</option>
                            <option value="off">Force OFF</option>
                        </select>
                    </div>
                }
            </div>

            @if (_isSuperAdmin && f.HasConfig && f.Key == "app-install" && f.Effective)
            {
                <div class="pm-feature-config">
                    <div class="pm-feature-config-title">🛡️ Application Control policy (block model)</div>
                    <div class="pm-field">
                        <label>Blocked file extensions (comma-separated)</label>
                        <input class="pm-input pm-input-sm" @bind="_cfgBlockedExt" placeholder=".exe, .msi" />
                    </div>
                    <div class="pm-field">
                        <label>Blocked name patterns (comma-separated, matches filename)</label>
                        <input class="pm-input pm-input-sm" @bind="_cfgBlockedNames" placeholder="steam, epicgames, game" />
                    </div>
                    <div class="pm-field">
                        <label>Allowed name patterns (exceptions that override a block)</label>
                        <input class="pm-input pm-input-sm" @bind="_cfgAllowedNames" placeholder="vscode, teams" />
                    </div>
                    <label class="pm-checkbox">
                        <input type="checkbox" @bind="_cfgBlockInstallers" />
                        Also block installers (setup.exe, *install*, msiexec-launched)
                    </label>
                    <div style="margin-top:.5rem">
                        <button class="pm-btn pm-btn-primary pm-btn-sm" @onclick="@(() => SaveAppControlConfig(f))">Save policy</button>
                        <span class="pm-hint" style="margin-left:.5rem">Applies immediately to @(_scopeMode == "device" ? "this device" : "all devices in the institution") that are online.</span>
                    </div>
                </div>
            }
        }
    </div>

    @if (_isSuperAdmin)
    {
        <p class="pm-hint" style="margin-top:1rem">
            Application Control uses a block model: listed extensions / name patterns are blocked for the
            logged-in user on the device; allowed patterns are exceptions. Enforcement is applied by the
            agent (Windows). Toggling the feature off removes enforcement cleanly.
        </p>
    }
}

@code {
    private bool _isSuperAdmin;
    private List<InstitutionDto> _institutions = [];
    private List<AgentDto>       _agents       = [];
    private List<FeatureStateDto> _features    = [];
    private string _selectedInstitution = "";
    private string _selectedAgent = "";
    private string _scopeMode = "institution";
    private bool _loading;
    private string? _msg; private bool _msgOk;
    private Guid? _myInstitution;

    // App-control policy editor state (empty by default — block nothing until configured)
    private string _cfgBlockedExt = "";
    private string _cfgBlockedNames = "";
    private string _cfgAllowedNames = "";
    private bool   _cfgBlockInstallers = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isSuperAdmin = auth.User.IsInRole("SuperAdmin");

        if (_isSuperAdmin)
        {
            // Full management: choose an institution first.
            _institutions = await Api.GetInstitutionsAsync() ?? [];
        }
        else
        {
            // Institution admin: read-only view of their own institution's features.
            var instClaim = auth.User.FindFirst("institution_id")?.Value;
            if (Guid.TryParse(instClaim, out var g)) _myInstitution = g;
            _features = await Api.GetMyFeaturesAsync() ?? [];
        }
    }

    private Guid? CurrentInstitution =>
        _isSuperAdmin
            ? (Guid.TryParse(_selectedInstitution, out var g) ? g : null)
            : _myInstitution;

    private async Task OnInstitutionChanged()
    {
        _selectedAgent = "";
        _scopeMode = "institution";
        await LoadAgents();
        await LoadFeatures();
    }

    private async Task OnScopeChanged()
    {
        _selectedAgent = "";
        if (_scopeMode == "device") await LoadAgents();
        await LoadFeatures();
    }

    private async Task LoadAgents()
    {
        var all = await Api.GetAgentsAsync() ?? [];
        var inst = CurrentInstitution;
        _agents = inst.HasValue
            ? all.Where(a => a.InstitutionId == inst.Value && a.Status == "Approved").ToList()
            : all.Where(a => a.Status == "Approved").ToList();
    }

    private async Task LoadFeatures()
    {
        var inst = CurrentInstitution;
        if (inst == null && _isSuperAdmin) { _features = []; return; }

        // In device mode we need a selected device
        Guid? agentId = null;
        if (_scopeMode == "device")
        {
            if (!Guid.TryParse(_selectedAgent, out var ag)) { _features = []; return; }
            agentId = ag;
        }

        _loading = true;
        _features = await Api.GetFeaturesAsync(inst, agentId) ?? [];
        _loading = false;

        // Populate the policy editor from the app-control feature's stored config (if any)
        var ac = _features.FirstOrDefault(f => f.Key == "app-install");
        if (ac?.ConfigJson is { Length: > 0 } cj)
        {
            try
            {
                var p = System.Text.Json.JsonSerializer.Deserialize<AppControlPolicy>(cj);
                if (p != null)
                {
                    _cfgBlockedExt      = string.Join(", ", p.BlockedExtensions);
                    _cfgBlockedNames    = string.Join(", ", p.BlockedNamePatterns);
                    _cfgAllowedNames    = string.Join(", ", p.AllowedNamePatterns);
                    _cfgBlockInstallers = p.BlockInstallers;
                }
            }
            catch { /* keep defaults */ }
        }
    }

    private static List<string> SplitCsv(string s) =>
        s.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task SaveAppControlConfig(FeatureStateDto f)
    {
        var inst = CurrentInstitution;
        if (inst == null) return;

        var policy = new AppControlPolicy
        {
            Enabled = true,
            BlockedExtensions   = SplitCsv(_cfgBlockedExt).Select(e => e.StartsWith('.') ? e : "." + e).ToList(),
            BlockedNamePatterns = SplitCsv(_cfgBlockedNames),
            AllowedNamePatterns = SplitCsv(_cfgAllowedNames),
            BlockInstallers     = _cfgBlockInstallers
        };
        var json = System.Text.Json.JsonSerializer.Serialize(policy);

        // Persist config WITH enabled=true so the feature stays on; scope follows the editor.
        SetFeatureFlagRequest req;
        if (_scopeMode == "device" && Guid.TryParse(_selectedAgent, out var ag))
            req = new SetFeatureFlagRequest(f.Key, "Agent", ag, true, json);
        else
            req = new SetFeatureFlagRequest(f.Key, "Institution", inst.Value, true, json);

        var (ok, error) = await Api.SetFeatureAsync(req);
        _msgOk = ok;
        _msg = ok ? "Application Control policy saved and pushed to online devices." : (error ?? "Save failed.");
        await LoadFeatures();
    }

    private async Task SetFeature(FeatureStateDto f, string? choice)
    {
        var inst = CurrentInstitution;
        if (inst == null) return;

        bool? enabled = choice switch { "on" => true, "off" => false, _ => (bool?)null };

        SetFeatureFlagRequest req;
        if (_scopeMode == "device" && Guid.TryParse(_selectedAgent, out var ag))
            req = new SetFeatureFlagRequest(f.Key, "Agent", ag, enabled, null);
        else
            req = new SetFeatureFlagRequest(f.Key, "Institution", inst.Value, enabled, null);

        var (ok, error) = await Api.SetFeatureAsync(req);
        _msgOk = ok;
        _msg = ok ? $"{f.Name} updated." : (error ?? "Update failed.");
        await LoadFeatures();
    }

    private static string OverrideValue(bool? v) => v switch { true => "on", false => "off", null => "inherit" };

    private static string StateLabel(bool? instEnabled, bool def)
        => instEnabled switch { true => "On", false => "Off", null => def ? "On (default)" : "Off (default)" };
}
