@page "/institutions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]
@using PeripheralMonitor.Server.Data
@using PeripheralMonitor.Web.Services
@inject ServerApiClient Api

<PageTitle>Institutions — Peripheral Monitor</PageTitle>

<div class="pm-page-header">
    <h1>Institutions</h1>
    <button class="pm-btn pm-btn-primary" @onclick="() => _showCreate = true">
        + New Institution
    </button>
</div>

<!-- Create modal -->
@if (_showCreate)
{
    <div class="pm-modal-overlay" @onclick="() => _showCreate = false">
        <div class="pm-modal" @onclick:stopPropagation>
            <h2>New Institution</h2>
            <div class="pm-field">
                <label>Name</label>
                <input class="pm-input" @bind="_newName" placeholder="Tirana University" />
            </div>
            <div class="pm-field">
                <label>Type</label>
                <select class="pm-input" @bind="_newType">
                    <option value="University">University</option>
                    <option value="School">School</option>
                    <option value="Company">Company</option>
                    <option value="Hospital">Hospital</option>
                    <option value="Government">Government</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="pm-field">
                <label>Contact Email</label>
                <input class="pm-input" @bind="_newEmail" type="email" placeholder="it@institution.edu" />
            </div>
            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="() => _showCreate = false">Cancel</button>
                <button class="pm-btn pm-btn-primary" @onclick="CreateAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_newName))">Create</button>
            </div>
        </div>
    </div>
}

<!-- Provision token modal -->
@if (_provisionToken != null)
{
    <div class="pm-modal-overlay" @onclick="() => _provisionToken = null">
        <div class="pm-modal pm-modal-wide" @onclick:stopPropagation>
            <h2>📦 Agent Provision Token</h2>
            <p class="pm-modal-hint">
                Place this in <code>appsettings.local.json</code> on the target machine.
                The agent will auto-register under <strong>@_provisionInstName</strong>.
            </p>
            <div class="pm-field">
                <label>appsettings.local.json</label>
                <textarea class="pm-input pm-mono pm-textarea" readonly>@GetProvisionJson()</textarea>
            </div>
            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="() => _provisionToken = null">Close</button>
                <button class="pm-btn pm-btn-primary" @onclick="CopyToken">📋 Copy</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <div class="pm-loading">Loading…</div>
}
else
{
    <div class="pm-table-wrapper">
        <table class="pm-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Type</th>
                    <th>Contact</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inst in _institutions)
                {
                    <tr>
                        <td><strong>@inst.Name</strong></td>
                        <td><code>@inst.Slug</code></td>
                        <td>@inst.Type</td>
                        <td>@inst.ContactEmail</td>
                        <td>@inst.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="pm-actions">
                            <button class="pm-btn pm-btn-secondary pm-btn-sm"
                                    @onclick="() => GetTokenAsync(inst)">
                                🔑 Provision Token
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!_institutions.Any())
        {
            <div class="pm-empty">No institutions yet. Create the first one above.</div>
        }
    </div>
}

@if (_message != null)
{
    <div class="pm-toast @(_isError ? "pm-toast-error" : "pm-toast-success")">@_message</div>
}

@code {
    private List<InstitutionEntity> _institutions = [];
    private bool    _loading         = true;
    private bool    _showCreate      = false;
    private string  _newName         = "";
    private string  _newType         = "University";
    private string  _newEmail        = "";
    private string? _provisionToken  = null;
    private string  _provisionInstName = "";
    private string? _message;
    private bool    _isError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading      = true;
        _institutions = await Api.GetInstitutionsAsync() ?? [];
        _loading      = false;
    }

    private async Task CreateAsync()
    {
        var inst = await Api.CreateInstitutionAsync(_newName, _newType, _newEmail);
        if (inst != null)
        {
            _showCreate = false;
            _newName = _newEmail = "";
            Toast("Institution created.", false);
            await LoadAsync();
        }
        else Toast("Failed to create institution.", true);
    }

    private async Task GetTokenAsync(InstitutionEntity inst)
    {
        _provisionToken    = await Api.GetProvisionTokenAsync(inst.Id);
        _provisionInstName = inst.Name;
    }

    private string GetProvisionJson() => $$"""
        {
          "SignalRUrl": "https://your-domain.com/monitor",
          "JwtToken": "{{_provisionToken}}"
        }
        """;

    private async Task CopyToken()
    {
        // JS interop to copy — simplified here
        Toast("Copy the JSON from the textarea above.", false);
        await Task.CompletedTask;
    }

    private void Toast(string msg, bool error)
    {
        _message = msg; _isError = error;
        _ = Task.Delay(4000).ContinueWith(_ => { _message = null; InvokeAsync(StateHasChanged); });
        StateHasChanged();
    }
}
