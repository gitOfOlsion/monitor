@page "/institutions"
@attribute [Authorize(Roles = "SuperAdmin,InstitutionAdmin")]
@inject ServerApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject TimeZoneService TZ

<PageTitle>Institutions — Peripheral Monitor</PageTitle>

<div class="pm-page-header">
    <h1>@(_isSuperAdmin ? "Institutions" : "My Institution")</h1>
    @if (_isSuperAdmin)
    {
        <button class="pm-btn pm-btn-primary" @onclick="() => _showCreate = true">+ New Institution</button>
    }
</div>

@if (_showCreate)
{
    <div class="pm-modal-overlay" @onclick="() => _showCreate = false">
        <div class="pm-modal" @onclick:stopPropagation>
            <h2>New Institution</h2>
            <div class="pm-field"><label>Name</label><input class="pm-input" @bind="_newName" placeholder="Tirana University" /></div>
            <div class="pm-field"><label>Type</label>
                <select class="pm-input" @bind="_newType">
                    <option value="University">University</option><option value="School">School</option>
                    <option value="Company">Company</option><option value="Hospital">Hospital</option>
                    <option value="Government">Government</option><option value="Other">Other</option>
                </select>
            </div>
            <div class="pm-field"><label>Contact Email</label><input class="pm-input" @bind="_newEmail" type="email" placeholder="it@@institution.edu" /></div>
            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="() => _showCreate = false">Cancel</button>
                <button class="pm-btn pm-btn-primary" @onclick="CreateAsync" disabled="@(string.IsNullOrWhiteSpace(_newName))">Create</button>
            </div>
        </div>
    </div>
}

@if (_showToken != null)
{
    <div class="pm-modal-overlay" @onclick="() => _showToken = null">
        <div class="pm-modal pm-modal-wide" @onclick:stopPropagation>
            <h2>📦 Download Agent for @_tokenInstName</h2>
            <p class="pm-modal-hint">
                Download the agent installer for the target platform. It is pre-configured
                for <strong>@_tokenInstName</strong> — no settings to enter.
            </p>

            <div class="pm-download-grid">
                <a class="pm-download-card" href="@GetWindowsInstallerUrl()" target="_blank">
                    <span class="pm-download-icon">🪟</span>
                    <span class="pm-download-label">Windows installer (.exe)</span>
                    <span class="pm-download-hint">Double-click and accept the admin prompt</span>
                </a>
                <a class="pm-download-card" href="@GetLinuxInstallerUrl()" target="_blank">
                    <span class="pm-download-icon">🐧</span>
                    <span class="pm-download-label">Linux installer (.run)</span>
                    <span class="pm-download-hint">Run: sudo sh PeripheralMonitorAgent-Setup-….run</span>
                </a>
            </div>

            <p class="pm-modal-hint" style="margin-top:.75rem">
                Mass deployment: Windows <code>…Setup-….exe install --quiet</code>,
                Linux <code>sudo sh …Setup-….run</code> (never prompts).
                Prefer plain scripts? <a href="@GetDownloadUrl("windows")" target="_blank">Windows .zip</a> ·
                <a href="@GetDownloadUrl("linux")" target="_blank">Linux .zip</a>.
            </p>

            <details style="margin-top:1rem">
                <summary style="cursor:pointer;font-size:13px;color:var(--text-muted)">
                    Or copy token manually (advanced)
                </summary>
                <div class="pm-field" style="margin-top:.75rem">
                    <label>appsettings.local.json</label>
                    <textarea class="pm-input pm-mono pm-textarea" readonly>@GetManualJson()</textarea>
                </div>
            </details>

            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="() => _showToken = null">Close</button>
            </div>
        </div>
    </div>
}

@if (_rdpInst != null)
{
    <div class="pm-modal-overlay" @onclick="CloseRdpCredentials">
        <div class="pm-modal" @onclick:stopPropagation>
            <h2>🔑 RDP Credentials — @_rdpInst.Name</h2>
            <p class="pm-modal-hint">
                These credentials are used by Guacamole to connect to every Windows machine
                in this institution via Remote Desktop. Use a domain account with RDP rights
                on these machines (no Active Directory policy changes needed). The password
                is stored encrypted and is never shown again after saving.
            </p>

            @if (_rdpConfigured)
            {
                <div class="pm-alert pm-alert-success" style="margin-bottom:1rem">
                    ✓ Configured — username: <strong>@_rdpExistingUsername</strong>
                    @if (!string.IsNullOrEmpty(_rdpExistingDomain)) { <text> (domain: @_rdpExistingDomain)</text> }
                </div>
            }

            <div class="pm-field">
                <label>Username</label>
                <input class="pm-input" @bind="_rdpUsername" placeholder="jdoe or jdoe@university.edu" />
            </div>
            <div class="pm-field">
                <label>Password</label>
                <input class="pm-input" type="password" @bind="_rdpPassword" placeholder="@(_rdpConfigured ? "Re-enter password to update" : "Enter password")" />
            </div>
            <div class="pm-field">
                <label>Domain (optional)</label>
                <input class="pm-input" @bind="_rdpDomain" placeholder="UNIVERSITY (leave blank if not using AD domain)" />
            </div>

            @if (_rdpError != null)
            { <div class="pm-alert pm-alert-error">@_rdpError</div> }

            <div class="pm-modal-actions">
                <button class="pm-btn pm-btn-secondary" @onclick="CloseRdpCredentials">Cancel</button>
                <button class="pm-btn pm-btn-primary" @onclick="SaveRdpCredentialsAsync"
                        disabled="@(_rdpSaving || string.IsNullOrWhiteSpace(_rdpUsername) || string.IsNullOrWhiteSpace(_rdpPassword))">
                    @(_rdpSaving ? "Saving…" : "Save Credentials")
                </button>
            </div>
        </div>
    </div>
}

@if (_loading)
{ <div class="pm-loading">Loading…</div> }
else
{
    <div class="pm-table-wrapper">
        <table class="pm-table">
            <thead><tr>
                <th>Name</th><th>Slug</th><th>Type</th><th>Contact</th><th>Created</th><th>Actions</th>
            </tr></thead>
            <tbody>
                @foreach (var i in _institutions)
                {
                    <tr>
                        <td data-label="Name"><strong>@i.Name</strong></td>
                        <td data-label="Slug"><code>@i.Slug</code></td>
                        <td data-label="Type">@i.Type</td>
                        <td data-label="Contact">@i.ContactEmail</td>
                        <td data-label="Created">@Fmt(i.CreatedAt, "yyyy-MM-dd")</td>
                        <td class="pm-actions">
                            <button class="pm-btn pm-btn-primary pm-btn-sm"
                                    @onclick="() => ShowDownloads(i)">
                                📦 Download Agent
                            </button>
                            <button class="pm-btn pm-btn-secondary pm-btn-sm"
                                    @onclick="() => OpenRdpCredentials(i)"
                                    title="Set the Windows sign-in credentials used for browser remote desktop">
                                🔑 RDP Credentials
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!_institutions.Any())
        {
            <div class="pm-empty">
                @(_isSuperAdmin ? "No institutions yet. Create the first one above." : "Your institution is not configured yet. Contact your administrator.")
            </div>
        }
    </div>
}

@if (_message != null)
{ <div class="pm-toast @(_isError ? "pm-toast-error" : "pm-toast-success")">@_message</div> }

<style>
    .pm-download-grid { display: flex; gap: 1rem; flex-wrap: wrap; }
    .pm-download-card {
        flex: 1; min-width: 200px; display: flex; flex-direction: column;
        align-items: center; gap: .5rem; padding: 1.5rem 1rem;
        background: var(--surface2); border: 2px solid var(--border);
        border-radius: var(--radius); text-decoration: none; color: var(--text);
        transition: border-color .15s, background .15s; cursor: pointer;
    }
    .pm-download-card:hover { border-color: var(--primary); background: var(--surface); }
    .pm-download-icon  { font-size: 2.5rem; }
    .pm-download-label { font-weight: 600; font-size: 14px; }
    .pm-download-hint  { font-size: 12px; color: var(--text-muted); }
</style>

@code {
    private List<InstitutionDto> _institutions = [];
    private bool _loading = true, _showCreate, _isSuperAdmin;
    private string _newName = "", _newType = "University", _newEmail = "";
    private InstitutionDto? _showToken;
    private string _tokenInstName = "";
    private string? _provisionToken;
    private string? _message;
    private bool _isError;
    private TimeSpan _tzOffset = TimeSpan.Zero;
    private bool _tzFetched;

    private string Fmt(DateTime utc, string format = "yyyy-MM-dd HH:mm:ss")
        => utc.Add(_tzOffset).ToString(format);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_tzFetched)
        {
            _tzFetched = true;
            _tzOffset = await TZ.GetOffsetAsync();
            StateHasChanged();
        }
    }

    // RDP credentials modal state
    private InstitutionDto? _rdpInst;
    private string _rdpUsername = "", _rdpPassword = "", _rdpDomain = "";
    private bool _rdpConfigured, _rdpSaving;
    private string? _rdpExistingUsername, _rdpExistingDomain, _rdpError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isSuperAdmin = auth.User.IsInRole("SuperAdmin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _institutions = await Api.GetInstitutionsAsync() ?? [];
        _loading = false;
    }

    private async Task CreateAsync()
    {
        var r = await Api.CreateInstitutionAsync(_newName, _newType, _newEmail);
        if (r != null) { _showCreate = false; _newName = _newEmail = ""; Toast("Institution created.", false); await LoadAsync(); }
        else Toast("Failed to create institution.", true);
    }

    private async Task ShowDownloads(InstitutionDto inst)
    {
        _showToken      = inst;
        _tokenInstName  = inst.Name;
        _provisionToken = await Api.GetProvisionTokenAsync(inst.Id);
    }

    private string GetDownloadUrl(string platform) =>
        $"/api/download/{_showToken?.Id}/{platform}";

    private string GetWindowsInstallerUrl() =>
        $"/api/download/{_showToken?.Id}/windows-installer";

    private string GetLinuxInstallerUrl() =>
        $"/api/download/{_showToken?.Id}/linux-installer";

    private async Task OpenRdpCredentials(InstitutionDto inst)
    {
        _rdpInst = inst;
        _rdpUsername = _rdpPassword = _rdpDomain = "";
        _rdpError = null;
        var (configured, username, domain) = await Api.GetRdpCredentialStatusAsync(inst.Id);
        _rdpConfigured = configured;
        _rdpExistingUsername = username;
        _rdpExistingDomain = domain;
        if (configured)
        {
            _rdpUsername = username ?? "";
            _rdpDomain = domain ?? "";
        }
    }

    private void CloseRdpCredentials()
    {
        _rdpInst = null;
        _rdpError = null;
    }

    private async Task SaveRdpCredentialsAsync()
    {
        if (_rdpInst == null || string.IsNullOrWhiteSpace(_rdpPassword)) return;
        _rdpSaving = true;
        _rdpError = null;

        var ok = await Api.SetRdpCredentialsAsync(_rdpInst.Id, _rdpUsername, _rdpPassword,
            string.IsNullOrWhiteSpace(_rdpDomain) ? null : _rdpDomain);

        _rdpSaving = false;
        if (ok)
        {
            Toast("RDP credentials saved.", false);
            CloseRdpCredentials();
        }
        else
        {
            _rdpError = "Failed to save credentials. Check your permissions and try again.";
        }
    }

    private string GetManualJson() => $$"""
        {
          "SignalRUrl": "{{Nav.BaseUri.TrimEnd('/')}}monitor",
          "JwtToken": "{{_provisionToken}}"
        }
        """;

    private void Toast(string msg, bool err)
    {
        _message = msg; _isError = err;
        _ = Task.Delay(4000).ContinueWith(_ => { _message = null; InvokeAsync(StateHasChanged); });
    }
}
