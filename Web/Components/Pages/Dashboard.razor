@page "/dashboard"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Security.Claims
@inject ServerApiClient Api
@inject RealtimeService Realtime
@inject AuthenticationStateProvider AuthState
@inject TimeZoneService TZ

<PageTitle>Dashboard</PageTitle>

<div class="pm-page-header">
    <div>
        <h1>@Greeting()</h1>
        <p class="pm-page-sub">Here's how your machines are doing right now.</p>
    </div>
    <span class="pm-hub-badge @(IsConnected ? "pm-badge-connected" : "pm-badge-disconnected")">
        <span class="pm-badge-dot"></span>@(IsConnected ? "Live" : "Reconnecting…")
    </span>
</div>

<div class="pm-stats-row">
    <div class="pm-stat-card">
        <div class="pm-stat-icon"><Icon Name="monitor" Size="22" /></div>
        <div><div class="pm-stat-value">@_agents.Count</div><div class="pm-stat-label">Total agents</div></div>
    </div>
    <div class="pm-stat-card pm-stat-green">
        <div class="pm-stat-icon"><Icon Name="check" Size="22" /></div>
        <div><div class="pm-stat-value">@_agents.Count(a => a.Status == "Approved")</div><div class="pm-stat-label">Approved</div></div>
    </div>
    <div class="pm-stat-card pm-stat-orange">
        <div class="pm-stat-icon"><Icon Name="history" Size="22" /></div>
        <div><div class="pm-stat-value">@_agents.Count(a => a.Status == "Pending")</div><div class="pm-stat-label">Waiting for approval</div></div>
    </div>
    <div class="pm-stat-card pm-stat-red">
        <div class="pm-stat-icon"><Icon Name="activity" Size="22" /></div>
        <div><div class="pm-stat-value">@_agents.Count(a => a.Status == "Offline")</div><div class="pm-stat-label">Offline</div></div>
    </div>
</div>

<!-- Active agents grouped by institution -->
<div class="pm-section">
    <h2>Active agents</h2>
    @foreach (var group in _agents.Where(a => a.Status == "Approved")
                                  .GroupBy(a => a.Institution?.Name ?? "Unassigned")
                                  .OrderBy(g => g.Key))
    {
        <h3 class="pm-group-header">@group.Key</h3>
        <div class="pm-agent-grid">
            @foreach (var a in group)
            {
                <div class="pm-agent-card @(IsStale(a) ? "pm-agent-stale" : "")">
                    <div class="pm-agent-name"><Icon Name="monitor" Size="16" /> @a.MachineName</div>
                    <div class="pm-agent-meta">@a.Platform</div>
                    <div class="pm-agent-meta">@a.IPAddress</div>
                    <div class="pm-agent-devices">@a.DeviceCount devices</div>
                    <div class="pm-agent-heartbeat">@(a.LastHeartbeat.HasValue ? Fmt(a.LastHeartbeat.Value, "HH:mm:ss") : "—")</div>
                </div>
            }
        </div>
    }
    @if (!_agents.Any(a => a.Status == "Approved"))
    {
        <div class="pm-empty">
            <strong>No agents online yet</strong>
            <span>Install the agent from <a href="/institutions">Institutions</a>, then approve it on the <a href="/agents">Agents</a> page.</span>
        </div>
    }
</div>

<!-- Live event feed -->
<div class="pm-section">
    <h2>Live event feed</h2>
    <div class="pm-event-feed">
        @foreach (var ev in _events.Take(100))
        {
            <div class="pm-event-row pm-event-@ev.EventType.ToLower()">
                <span class="pm-event-time">@Fmt(ev.Timestamp, "HH:mm:ss")</span>
                <span class="pm-event-machine">@ev.MachineName</span>
                <span class="pm-badge pm-badge-@ev.EventType.ToLower()">@ev.EventType</span>
                <span class="pm-event-name">@ev.FriendlyName</span>
                <span class="pm-event-category">@ev.Category</span>
            </div>
        }
        @if (!_events.Any())
        {
            <div class="pm-empty">
                <strong>All quiet</strong>
                <span>Device plug-ins and unplugs will appear here the moment they happen.</span>
            </div>
        }
    </div>
</div>

@code {
    private List<AgentDto>             _agents = [];
    private List<DeviceChangedPayload> _events = [];
    private TimeSpan _tzOffset = TimeSpan.Zero;
    private bool _tzFetched;

    private bool IsConnected => Realtime.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;

    private string Fmt(DateTime utc, string format = "yyyy-MM-dd HH:mm:ss")
        => utc.Add(_tzOffset).ToString(format);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_tzFetched)
        {
            _tzFetched = true;
            _tzOffset = await TZ.GetOffsetAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var role = auth.User.FindFirst(ClaimTypes.Role)?.Value ?? "Viewer";
        var inst = auth.User.FindFirst("institution_id")?.Value;

        await Realtime.EnsureConnectedAsync(role, inst);
        Realtime.OnHeartbeat     += HandleHeartbeat;
        Realtime.OnDeviceChanged += HandleDeviceChanged;

        _agents = await Api.GetAgentsAsync() ?? [];
        var db  = await Api.GetEventsAsync(100) ?? [];
        _events = db.Select(e => new DeviceChangedPayload(
            e.MachineName, Guid.Empty, e.EventType, e.DeviceId,
            e.FriendlyName, e.Category, e.Status, e.Timestamp)).ToList();
    }

    private void HandleHeartbeat(HeartbeatPayload p)
    {
        var a = _agents.FirstOrDefault(x => x.MachineName == p.MachineName);
        if (a != null) { a.LastHeartbeat = p.Timestamp; a.DeviceCount = p.DeviceCount; a.Status = "Approved"; a.Platform = p.Platform; }
        InvokeAsync(StateHasChanged);
    }

    private void HandleDeviceChanged(DeviceChangedPayload p)
    {
        _events.Insert(0, p);
        if (_events.Count > 200) _events.RemoveAt(200);
        InvokeAsync(StateHasChanged);
    }

    private static bool IsStale(AgentDto a) => a.LastHeartbeat.HasValue && (DateTime.UtcNow - a.LastHeartbeat.Value).TotalSeconds > 30;
    private string Greeting()
    {
        var hour = DateTime.UtcNow.Add(_tzOffset).Hour;
        return hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    }

    public async ValueTask DisposeAsync()
    {
        Realtime.OnHeartbeat     -= HandleHeartbeat;
        Realtime.OnDeviceChanged -= HandleDeviceChanged;
        await Task.CompletedTask;
    }
}
