@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ServerApiClient Api
@inject RealtimeService Realtime

<PageTitle>Dashboard — Peripheral Monitor</PageTitle>

<div class="pm-page-header">
    <h1>Dashboard</h1>
    <span class="pm-hub-badge @(IsConnected ? "pm-badge-connected" : "pm-badge-disconnected")">
        ● @(IsConnected ? "Live" : "Reconnecting…")
    </span>
</div>

<div class="pm-stats-row">
    <div class="pm-stat-card">
        <div class="pm-stat-value">@_agents.Count</div>
        <div class="pm-stat-label">Total Agents</div>
    </div>
    <div class="pm-stat-card pm-stat-green">
        <div class="pm-stat-value">@_agents.Count(a => a.Status == "Approved")</div>
        <div class="pm-stat-label">Approved</div>
    </div>
    <div class="pm-stat-card pm-stat-orange">
        <div class="pm-stat-value">@_agents.Count(a => a.Status == "Pending")</div>
        <div class="pm-stat-label">Pending</div>
    </div>
    <div class="pm-stat-card pm-stat-red">
        <div class="pm-stat-value">@_agents.Count(a => a.Status == "Offline")</div>
        <div class="pm-stat-label">Offline</div>
    </div>
</div>

<div class="pm-section">
    <h2>Active Agents</h2>
    <div class="pm-agent-grid">
        @foreach (var a in _agents.Where(a => a.Status == "Approved"))
        {
            <div class="pm-agent-card @(IsStale(a) ? "pm-agent-stale" : "")">
                <div class="pm-agent-name">@GetIcon(a.Platform) @a.MachineName</div>
                <div class="pm-agent-meta">@(a.Institution?.Name ?? "—")</div>
                <div class="pm-agent-meta">@a.IPAddress</div>
                <div class="pm-agent-devices">@a.DeviceCount devices</div>
                <div class="pm-agent-heartbeat">@(a.LastHeartbeat?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</div>
            </div>
        }
        @if (!_agents.Any(a => a.Status == "Approved"))
        { <div class="pm-empty">No approved agents online.</div> }
    </div>
</div>

<div class="pm-section">
    <h2>Live Event Feed</h2>
    <div class="pm-event-feed">
        @foreach (var ev in _events.Take(100))
        {
            <div class="pm-event-row pm-event-@ev.EventType.ToLower()">
                <span class="pm-event-time">@ev.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="pm-event-machine">@ev.MachineName</span>
                <span class="pm-badge pm-badge-@ev.EventType.ToLower()">@ev.EventType</span>
                <span class="pm-event-name">@ev.FriendlyName</span>
                <span class="pm-event-category">@ev.Category</span>
            </div>
        }
        @if (!_events.Any())
        { <div class="pm-empty">Waiting for events…</div> }
    </div>
</div>

@code {
    private List<AgentDto>             _agents = [];
    private List<DeviceChangedPayload> _events = [];

    private bool IsConnected => Realtime.State ==
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        await Realtime.EnsureConnectedAsync();
        Realtime.OnHeartbeat     += HandleHeartbeat;
        Realtime.OnDeviceChanged += HandleDeviceChanged;

        _agents = await Api.GetAgentsAsync() ?? [];
        var db  = await Api.GetEventsAsync(100) ?? [];
        _events = db.Select(e => new DeviceChangedPayload(
            e.MachineName, Guid.Empty, e.EventType, e.DeviceId,
            e.FriendlyName, e.Category, e.Status, e.Timestamp)).ToList();
    }

    private void HandleHeartbeat(HeartbeatPayload p)
    {
        var a = _agents.FirstOrDefault(x => x.MachineName == p.MachineName);
        if (a != null) { a.LastHeartbeat = p.Timestamp; a.DeviceCount = p.DeviceCount; a.Status = "Approved"; }
        InvokeAsync(StateHasChanged);
    }

    private void HandleDeviceChanged(DeviceChangedPayload p)
    {
        _events.Insert(0, p);
        if (_events.Count > 200) _events.RemoveAt(200);
        InvokeAsync(StateHasChanged);
    }

    private static bool IsStale(AgentDto a) =>
        a.LastHeartbeat.HasValue && (DateTime.UtcNow - a.LastHeartbeat.Value).TotalSeconds > 30;
    private static string GetIcon(string p) => p switch { "Windows" => "🪟", "Linux" => "🐧", _ => "❓" };

    public async ValueTask DisposeAsync()
    {
        Realtime.OnHeartbeat     -= HandleHeartbeat;
        Realtime.OnDeviceChanged -= HandleDeviceChanged;
        await Task.CompletedTask;
    }
}
