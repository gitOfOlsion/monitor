@page "/login"
@layout PeripheralMonitor.Web.Components.Layout.EmptyLayout
@inject NavigationManager Nav

<PageTitle>Sign In — Peripheral Monitor</PageTitle>

<div class="pm-login-wrap">
    <div class="pm-login-left">
        <div class="pm-login-brand">
            <span class="pm-brand-mark pm-brand-mark-lg"><Icon Name="logo" Size="28" /></span>
            <h1>Every device,<br />one calm dashboard.</h1>
            <p class="pm-login-tagline">Centralised device visibility across all your institutions.</p>
        </div>
        <ul class="pm-login-features">
            <li><Icon Name="usb" /> Real-time peripheral tracking: USB, keyboard, mouse, audio</li>
            <li><Icon Name="globe" /> Multi-institution dashboard with clean tenant separation</li>
            <li><Icon Name="history" /> Device event history and a full audit log</li>
            <li><Icon Name="remote" /> Remote desktop in the browser, no client to install</li>
            <li><Icon Name="user" /> See who is signed in on each machine</li>
        </ul>
        <p class="pm-login-footer">© @DateTime.UtcNow.Year Peripheral Monitor</p>
    </div>

    <div class="pm-login-right">
        <div class="pm-login-card">
            <a class="pm-login-mobile-brand" href="/"><span class="pm-brand-mark"><Icon Name="logo" Size="20" /></span> Peripheral Monitor</a>
            <div class="pm-login-card-header">
                <h2>Welcome back</h2>
                <p>Sign in to see your machines.</p>
            </div>

            @if (ShowError)
            {
                <div class="pm-alert pm-alert-error">
                    That username and password don't match. Please try again.
                </div>
            }

            <form method="post" action="/auth/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <div class="pm-field">
                    <label for="username">Username</label>
                    <input id="username" name="username" type="text"
                           class="pm-input" autocomplete="username"
                           placeholder="Enter your username" required autofocus />
                </div>
                <div class="pm-field">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password"
                           class="pm-input" autocomplete="current-password"
                           placeholder="Enter your password" required />
                </div>
                <button type="submit" class="pm-btn pm-btn-primary pm-btn-full pm-login-submit">
                    Sign in <Icon Name="arrow" Size="16" />
                </button>
            </form>

            <div class="pm-login-divider"><span>New here?</span></div>
            <a href="/demo" class="pm-btn pm-btn-secondary pm-btn-full">Try a free demo</a>

            <p class="pm-login-hint">
                Contact your system administrator if you have forgotten your credentials.
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl  { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool   ShowError   { get; set; }
}
