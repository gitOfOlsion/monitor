@page "/agents"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using PeripheralMonitor.Server.Data
@using PeripheralMonitor.Web.Services
@inject ServerApiClient Api

<PageTitle>Agents — Peripheral Monitor</PageTitle>

<div class="pm-page-header">
    <h1>Agents</h1>
    <button class="pm-btn pm-btn-secondary" @onclick="LoadAsync">↻ Refresh</button>
</div>

@if (_loading)
{
    <div class="pm-loading">Loading agents…</div>
}
else
{
    <!-- Pending approval banner -->
    @if (_agents.Any(a => a.Status == "Pending"))
    {
        <div class="pm-alert pm-alert-warning">
            ⚠️ @_agents.Count(a => a.Status == "Pending") agent(s) waiting for approval.
        </div>
    }

    <div class="pm-table-wrapper">
        <table class="pm-table">
            <thead>
                <tr>
                    <th>Machine</th>
                    <th>Platform</th>
                    <th>Institution</th>
                    <th>IP</th>
                    <th>MAC</th>
                    <th>Status</th>
                    <th>Last Heartbeat</th>
                    <th>Devices</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _agents)
                {
                    <tr>
                        <td><strong>@a.MachineName</strong></td>
                        <td>@GetPlatformIcon(a.Platform) @a.Platform</td>
                        <td>@(a.Institution?.Name ?? "—")</td>
                        <td>@a.IPAddress</td>
                        <td><code>@a.MacAddress</code></td>
                        <td><span class="pm-badge pm-badge-@a.Status.ToLower()">@a.Status</span></td>
                        <td>@(a.LastHeartbeat?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")</td>
                        <td>@a.DeviceCount</td>
                        <td class="pm-actions">
                            @if (a.Status == "Pending")
                            {
                                <button class="pm-btn pm-btn-success pm-btn-sm"
                                        @onclick="() => ApproveAsync(a.Id)">✓ Approve</button>
                                <button class="pm-btn pm-btn-danger pm-btn-sm"
                                        @onclick="() => RejectAsync(a.Id)">✗ Reject</button>
                            }
                            @if (a.Status == "Approved")
                            {
                                <button class="pm-btn pm-btn-secondary pm-btn-sm"
                                        @onclick="() => ApproveAsync(a.Id)">↻ Re-issue Token</button>
                            }
                            @if (a.Status != "Approved")
                            {
                                <button class="pm-btn pm-btn-danger pm-btn-sm"
                                        @onclick="() => DeleteAsync(a.Id)">🗑 Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!_agents.Any())
        {
            <div class="pm-empty">
                No agents discovered yet. Install the agent on a machine on your network.
            </div>
        }
    </div>
}

@if (_message != null)
{
    <div class="pm-toast @(_isError ? "pm-toast-error" : "pm-toast-success")">@_message</div>
}

@code {
    private List<AgentEntity> _agents  = [];
    private bool              _loading = true;
    private string?           _message;
    private bool              _isError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _agents  = await Api.GetAgentsAsync() ?? [];
        _loading = false;
    }

    private async Task ApproveAsync(Guid id)
    {
        var ok = await Api.ApproveAsync(id);
        Toast(ok ? "Agent approved." : "Failed to approve.", !ok);
        if (ok) await LoadAsync();
    }

    private async Task RejectAsync(Guid id)
    {
        var ok = await Api.RejectAsync(id);
        Toast(ok ? "Agent rejected." : "Failed.", !ok);
        if (ok) await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var ok = await Api.DeleteAsync(id);
        Toast(ok ? "Agent deleted." : "Cannot delete — approved agents are protected.", !ok);
        if (ok) await LoadAsync();
    }

    private void Toast(string msg, bool error)
    {
        _message = msg; _isError = error;
        _ = Task.Delay(4000).ContinueWith(_ => { _message = null; InvokeAsync(StateHasChanged); });
        StateHasChanged();
    }

    private static string GetPlatformIcon(string p) => p switch
    {
        "Windows" => "🪟", "Linux" => "🐧", _ => "❓"
    };
}
