@page "/"
@layout PeripheralMonitor.Web.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Nav

<PageTitle>Peripheral Monitor — Centralised device visibility</PageTitle>

<div class="pm-landing">

    <!-- Top bar -->
    <header class="pm-landing-nav">
        <div class="pm-landing-brand">
            <span class="pm-landing-logo">📡</span>
            <span>Peripheral Monitor</span>
        </div>
        <a href="/demo" class="pm-btn pm-btn-primary pm-btn-sm">🚀 Try a demo</a>
    </header>

    <!-- Hero -->
    <section class="pm-hero">
        <div class="pm-hero-inner">
            <h1>Centralised device visibility<br/>across all your institutions</h1>
            <p class="pm-hero-sub">
                Real-time peripheral monitoring, live system metrics, browser-based remote desktop,
                and application control — for every machine, in one dashboard.
            </p>
            <div class="pm-hero-cta">
                <a href="/demo" class="pm-btn pm-btn-light">🚀 Start a free demo →</a>
                <a href="/login" class="pm-hero-link">or sign in</a>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section class="pm-services">
        <div class="pm-services-inner">
            <h2>What it does</h2>
            <p class="pm-services-intro">Select a capability to learn more.</p>

            <div class="pm-service-grid">
                @foreach (var s in _services)
                {
                    <button class="pm-service-card @(_selected == s.Key ? "pm-service-active" : "")"
                            @onclick="() => Select(s.Key)">
                        <span class="pm-service-icon">@s.Icon</span>
                        <span class="pm-service-title">@s.Title</span>
                    </button>
                }
            </div>

            @if (_current != null)
            {
                <div class="pm-service-detail" @key="_current.Key">
                    <div class="pm-service-detail-text">
                        <h3>@_current.Icon @_current.Title</h3>
                        <p>@_current.Description</p>
                        <ul>
                            @foreach (var p in _current.Points)
                            { <li>@p</li> }
                        </ul>
                    </div>
                    <div class="pm-service-detail-art">
                        @((MarkupString)_current.Svg)
                    </div>
                </div>
            }
        </div>
    </section>

    <footer class="pm-landing-footer">
        © @DateTime.UtcNow.Year Peripheral Monitor · All rights reserved
    </footer>
</div>

@code {
    private string _selected = "tracking";
    private Service? _current => _services.FirstOrDefault(s => s.Key == _selected);

    private void Select(string key) => _selected = key;

    private record Service(string Key, string Icon, string Title, string Description, string[] Points, string Svg);

    private readonly List<Service> _services = new()
    {
        new("tracking", "🖥️", "Real-time peripheral tracking",
            "Track USB, keyboard, mouse, audio, HID, Bluetooth, storage and display devices the moment they connect or disconnect — with a durable event history that survives restarts.",
            new[] { "USB, input, audio, storage and more", "Instant connect / disconnect events", "Durable history that survives reconnects" },
            SvgTracking),
        new("metrics", "📊", "Live system metrics",
            "See per-device CPU, memory, disk activity and network throughput in real time, sampled from the same performance counters Task Manager uses.",
            new[] { "CPU · RAM · Disk · Network", "Live gauges and sparklines", "Task-Manager-accurate sampling" },
            SvgMetrics),
        new("remote", "🔑", "Web-based remote desktop",
            "Open a full remote desktop session in the browser — no client to install. Works even for machines behind NAT, thanks to a secure reverse tunnel.",
            new[] { "Clientless RDP in the browser", "Works behind NAT / firewalls", "No inbound ports required" },
            SvgRemote),
        new("tenant", "🌐", "Multi-institution & multi-tenant",
            "Each institution admin sees only their own devices; super admins see everything. Roles keep every tenant's data cleanly separated.",
