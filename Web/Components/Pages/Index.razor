@page "/"
@layout PeripheralMonitor.Web.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject ServerApiClient Api

<Seo Title="USB & Device Monitoring with Browser Remote Desktop | Peripheral Monitor"
     SocialTitle="Peripheral Monitor: USB & device monitoring with remote desktop in the browser"
     Description="Track USB drives, keyboards and other peripherals in real time, watch live CPU and memory, and open remote desktop in the browser for every Windows and Linux PC."
     Path="/" JsonLd="_jsonLd" />

<div class="pm-landing">

    <!-- Top bar -->
    <header class="pm-landing-nav">
        <a class="pm-landing-brand" href="/" aria-label="Peripheral Monitor home">
            <span class="pm-brand-mark"><Icon Name="logo" Size="20" /></span>
            <span>Peripheral Monitor</span>
        </a>
        <nav class="pm-landing-nav-actions" aria-label="Site">
            <a href="#features" class="pm-landing-nav-link">Features</a>
            <a href="#how-it-works" class="pm-landing-nav-link">How it works</a>
            <a href="#faq" class="pm-landing-nav-link">FAQ</a>
            <a href="/login" class="pm-landing-nav-link">Sign in</a>
            <a href="/demo" class="pm-btn pm-btn-primary pm-btn-sm">Try a demo</a>
        </nav>
    </header>

    <main>
    <!-- Hero -->
    <section class="pm-hero" aria-labelledby="hero-title">
        <div class="pm-hero-inner">
            <div>
                <span class="pm-hero-eyebrow"><Icon Name="activity" Size="15" /> USB, peripheral and PC monitoring for institutions</span>
                <h1 id="hero-title">Monitor every device, <em>across every institution.</em></h1>
                <p class="pm-hero-sub">
                    See USB drives, keyboards, mice and headsets the moment they connect, watch live CPU,
                    memory and network use, and open a remote desktop in the browser, for every Windows
                    and Linux PC in one calm dashboard.
                </p>
                <div class="pm-hero-cta">
                    <a href="/demo" class="pm-btn pm-btn-primary pm-btn-lg">Start a free demo <Icon Name="arrow" Size="17" /></a>
                    <a href="/login" class="pm-hero-link">Sign in</a>
                </div>
                <div class="pm-hero-trust">
                    <span><Icon Name="check" Size="15" /> No client for remote desktop</span>
                    <span><Icon Name="check" Size="15" /> Works behind NAT</span>
                    <span><Icon Name="check" Size="15" /> One-file installers</span>
                </div>
            </div>

            <!-- Static preview of the dashboard, decorative -->
            <div class="pm-hero-preview" aria-hidden="true">
                <div class="pm-hp-bar"><i></i><i></i><i></i><b>Live</b></div>
                <div class="pm-hp-stats">
                    <div class="pm-hp-stat"><strong>128</strong><span>Agents</span></div>
                    <div class="pm-hp-stat"><strong>124</strong><span>Online</span></div>
                    <div class="pm-hp-stat"><strong>3</strong><span>Pending</span></div>
                </div>
                <div class="pm-hp-rows">
                    <div class="pm-hp-row"><time>09:41</time> LAB1-PC07 · USB drive <span class="pm-badge pm-badge-connected">Connected</span></div>
                    <div class="pm-hp-row"><time>09:39</time> LIB-DESK02 · Headset <span class="pm-badge pm-badge-disconnected">Disconnected</span></div>
                    <div class="pm-hp-row"><time>09:36</time> ADMIN-04 · Keyboard <span class="pm-badge pm-badge-modified">Modified</span></div>
                </div>
                <div class="pm-hp-spark">
                    <svg viewBox="0 0 300 62" preserveAspectRatio="none">
                        <path d="M0 46 C30 40 45 22 75 28 S120 50 150 34 S205 10 235 22 S280 30 300 18 V62 H0Z" fill="var(--primary-soft)" />
                        <path d="M0 46 C30 40 45 22 75 28 S120 50 150 34 S205 10 235 22 S280 30 300 18" fill="none" stroke="var(--primary)" stroke-width="2.2" />
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section class="pm-services" id="features" aria-labelledby="features-title">
        <div class="pm-services-inner">
            <h2 id="features-title">Everything you need to look after your machines</h2>
            <p class="pm-services-intro">Pick a capability to see what it does.</p>

            <div class="pm-service-grid" role="tablist" aria-label="Capabilities">
                @foreach (var s in _services)
                {
                    <button class="pm-service-card @(_selected == s.Key ? "pm-service-active" : "")"
                            role="tab" id="tab-@s.Key" aria-controls="panel-@s.Key"
                            aria-selected="@(_selected == s.Key ? "true" : "false")"
                            @onclick="() => Select(s.Key)">
                        <span class="pm-service-icon"><Icon Name="@s.Icon" Size="20" /></span>
                        <span class="pm-service-title">@s.Title</span>
                    </button>
                }
            </div>

            @* Every panel is in the HTML so search engines can read all six; only the selected one is shown. *@
            @foreach (var s in _services)
            {
                <div class="pm-service-detail" id="panel-@s.Key" role="tabpanel" aria-labelledby="tab-@s.Key"
                     hidden="@(_selected != s.Key)">
                    <div class="pm-service-detail-text">
                        <h3><Icon Name="@s.Icon" Size="22" /> @s.Title</h3>
                        <p>@s.Description</p>
                        <ul>
                            @foreach (var p in s.Points)
                            { <li>@p</li> }
                        </ul>
                    </div>
                    <div class="pm-service-detail-art" aria-hidden="true">
                        @((MarkupString)s.Svg)
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- How it works -->
    <section class="pm-steps-section" id="how-it-works" aria-labelledby="how-title">
        <div class="pm-services-inner">
            <h2 id="how-title">Up and running in three steps</h2>
            <p class="pm-services-intro">No servers to configure on each PC and no ports to open on your network.</p>
            <ol class="pm-steps">
                <li class="pm-step">
                    <span class="pm-step-num">1</span>
                    <h3>Create your institution</h3>
                    <p>Add a school, company or department and invite admins. Each institution only sees its own machines.</p>
                </li>
                <li class="pm-step">
                    <span class="pm-step-num">2</span>
                    <h3>Install the one-file agent</h3>
                    <p>Download a ready-configured installer: an <strong>.exe</strong> for Windows or a <strong>.run</strong> file for Linux. It works silently for mass deployment too.</p>
                </li>
                <li class="pm-step">
                    <span class="pm-step-num">3</span>
                    <h3>Approve and start monitoring</h3>
                    <p>Approve the new PC in the dashboard. Device events, live metrics and remote desktop are available straight away.</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- Who it's for -->
    <section class="pm-services pm-audience-section" aria-labelledby="audience-title">
        <div class="pm-services-inner">
            <h2 id="audience-title">Built for teams that look after many PCs</h2>
            <div class="pm-audience-grid">
                <article class="pm-audience">
                    <span class="pm-service-icon"><Icon Name="building" Size="20" /></span>
                    <h3>Schools and universities</h3>
                    <p>Keep computer labs and libraries in order: see who plugged in a USB stick, which lab PC is offline, and help students remotely.</p>
                </article>
                <article class="pm-audience">
                    <span class="pm-service-icon"><Icon Name="users" Size="20" /></span>
                    <h3>Companies and IT teams</h3>
                    <p>Monitor office and remote workstations, block unapproved applications and support staff without installing a remote-access client.</p>
                </article>
                <article class="pm-audience">
                    <span class="pm-service-icon"><Icon Name="shield" Size="20" /></span>
                    <h3>Hospitals and public sector</h3>
                    <p>Track removable storage on sensitive machines and keep a full audit trail of every administrative action.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="pm-steps-section" id="faq" aria-labelledby="faq-title">
        <div class="pm-services-inner pm-faq-inner">
            <h2 id="faq-title">Frequently asked questions</h2>
            <div class="pm-faq">
                @foreach (var f in _faq)
                {
                    <details class="pm-faq-item">
                        <summary>@f.Q</summary>
                        <p>@f.A</p>
                    </details>
                }
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section class="pm-contact" id="contact" aria-labelledby="contact-title">
        <div class="pm-contact-inner">
            <div class="pm-contact-intro">
                <h2 id="contact-title">Get in touch</h2>
                <p>
                    Questions about deployment, pricing, or whether Peripheral Monitor fits your
                    institution? Send a message and we'll get back to you.
                </p>
                <ul class="pm-contact-points">
                    <li><Icon Name="mail" /> Tell us about your setup and we'll advise</li>
                    <li><Icon Name="arrow" /> Or <a href="/demo">start a free demo</a> right now</li>
                </ul>
            </div>

            <div class="pm-contact-form">
                @if (_sent)
                {
                    <div class="pm-alert pm-alert-success">
                        Thanks, @_name — your message has been sent. We'll reply to <strong>@_email</strong>.
                    </div>
                    <button class="pm-btn pm-btn-secondary pm-btn-sm" @onclick="ResetForm">Send another message</button>
                }
                else
                {
                    @if (_error != null)
                    { <div class="pm-alert pm-alert-error">@_error</div> }

                    <div class="pm-contact-row">
                        <div class="pm-field">
                            <label for="c-name">Name</label>
                            <input id="c-name" class="pm-input" @bind="_name" placeholder="Your name" autocomplete="name" />
                        </div>
                        <div class="pm-field">
                            <label for="c-email">Email</label>
                            <input id="c-email" class="pm-input" type="email" @bind="_email" placeholder="you@example.com" autocomplete="email" />
                        </div>
                    </div>
                    <div class="pm-contact-row">
                        <div class="pm-field">
                            <label for="c-phone">Phone number</label>
                            <input id="c-phone" class="pm-input" type="tel" @bind="_phone" placeholder="+355 …" autocomplete="tel" />
                        </div>
                        <div class="pm-field">
                            <label for="c-subject">Subject</label>
                            <input id="c-subject" class="pm-input" @bind="_subject" placeholder="How can we help?" />
                        </div>
                    </div>
                    <div class="pm-field">
                        <label for="c-message">Message</label>
                        <textarea id="c-message" class="pm-input pm-textarea" rows="5" @bind="_message"
                                  placeholder="Tell us a bit about what you need…"></textarea>
                    </div>

                    @* Honeypot — hidden from people, tempting to bots. Must stay empty. *@
                    <div class="pm-hp" aria-hidden="true">
                        <label>Website</label>
                        <input class="pm-input" @bind="_website" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="pm-field">
                        <label for="c-captcha">Verification: @(_captcha?.Question ?? "loading…")</label>
                        <div class="pm-contact-captcha">
                            <input id="c-captcha" class="pm-input" @bind="_captchaAnswer" placeholder="your answer" />
                            <button class="pm-btn pm-btn-secondary pm-btn-sm" type="button"
                                    @onclick="RefreshCaptcha" title="New question" aria-label="New question">↻</button>
                        </div>
                    </div>

                    <button class="pm-btn pm-btn-primary pm-btn-full" @onclick="SubmitAsync" disabled="@_sending">
                        @(_sending ? "Sending…" : "Send message")
                    </button>
                }
            </div>
        </div>
    </section>

    </main>

    <footer class="pm-landing-footer">
        <nav class="pm-footer-links" aria-label="Footer">
            <a href="#features">Features</a>
            <a href="#how-it-works">How it works</a>
            <a href="#faq">FAQ</a>
            <a href="#contact">Contact</a>
            <a href="/demo">Free demo</a>
            <a href="/login">Sign in</a>
        </nav>
        <span>© @DateTime.UtcNow.Year Peripheral Monitor</span>
    </footer>
</div>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;

    private string _selected = "tracking";
    private void Select(string key) => _selected = key;

    // ── FAQ (shown on the page and mirrored in FAQPage structured data) ─────
    private record Faq(string Q, string A);
    private readonly Faq[] _faq =
    {
        new("What does Peripheral Monitor do?",
            "It shows every Windows and Linux PC in your institutions in one dashboard: which USB and other peripheral devices connect or disconnect, live CPU, memory, disk and network use, who is signed in, and a remote desktop you open in the browser."),
        new("Do I need to open firewall ports or install a remote-desktop client?",
            "No. The agent on each PC connects out to the server through a secure reverse tunnel, so remote desktop works behind NAT and firewalls with no inbound ports and nothing to install on the admin's computer."),
        new("Which operating systems are supported?",
            "Windows (installed as a service from a single .exe) and Linux with systemd (installed from a single .run file). Both installers support silent mass deployment."),
        new("Which devices can it track?",
            "USB storage, keyboards, mice, audio devices, HID devices, Bluetooth, storage and displays. Every connect and disconnect is recorded in a history that survives restarts."),
        new("Can several schools or companies share one installation?",
            "Yes. Each institution admin sees only their own machines, super admins see everything, and roles keep every tenant's data separate."),
        new("Can I try it before deploying it everywhere?",
            "Yes. Start a free 15-day demo: you get your own institution and admin account in seconds, with all features except application control."),
    };

    // ── Structured data for search engines (JSON-LD) ───────────────────────
    private Dictionary<string, object> _jsonLd = new();

    protected override void OnInitialized()
    {
        var site = SiteUrl.Base(Config);
        _jsonLd = new()
        {
            ["@context"] = "https://schema.org",
            ["@graph"] = new object[]
            {
                new Dictionary<string, object>
                {
                    ["@type"] = "Organization", ["@id"] = site + "/#org",
                    ["name"] = "Peripheral Monitor", ["url"] = site + "/",
                    ["logo"] = site + "/icon-512.png",
                },
                new Dictionary<string, object>
                {
                    ["@type"] = "WebSite", ["@id"] = site + "/#website",
                    ["name"] = "Peripheral Monitor", ["url"] = site + "/",
                    ["publisher"] = new Dictionary<string, object> { ["@id"] = site + "/#org" },
                    ["inLanguage"] = "en",
                },
                new Dictionary<string, object>
                {
                    ["@type"] = "SoftwareApplication", ["@id"] = site + "/#app",
                    ["name"] = "Peripheral Monitor",
                    ["applicationCategory"] = "BusinessApplication",
                    ["applicationSubCategory"] = "Device monitoring and remote desktop",
                    ["operatingSystem"] = "Windows, Linux",
                    ["url"] = site + "/",
                    ["image"] = site + "/og-image.png",
                    ["description"] = "USB and peripheral device monitoring, live system metrics, browser-based remote desktop and application control for every Windows and Linux PC across your institutions.",
                    ["featureList"] = _services.Select(s => s.Title).ToArray(),
                    ["offers"] = new Dictionary<string, object>
                    {
                        ["@type"] = "Offer", ["price"] = "0", ["priceCurrency"] = "EUR",
                        ["description"] = "Free 15-day demo",
                        ["url"] = site + "/demo",
                    },
                    ["publisher"] = new Dictionary<string, object> { ["@id"] = site + "/#org" },
                },
                new Dictionary<string, object>
                {
                    ["@type"] = "FAQPage", ["@id"] = site + "/#faq",
                    ["mainEntity"] = _faq.Select(f => new Dictionary<string, object>
                    {
                        ["@type"] = "Question", ["name"] = f.Q,
                        ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = f.A },
                    }).ToArray(),
                },
            },
        };
    }

    // ── Contact form ─────────────────────────────────────────────────────────
    private string _name = "", _email = "", _phone = "", _subject = "", _message = "";
    private string _captchaAnswer = "", _website = "";   // _website = honeypot
    private CaptchaChallengeDto? _captcha;
    private bool _sending, _sent;
    private string? _error;

    protected override async Task OnInitializedAsync() => await RefreshCaptcha();

    private async Task RefreshCaptcha()
    {
        _captchaAnswer = "";
        try { _captcha = await Api.GetCaptchaAsync(); } catch { _captcha = null; }
    }

    private void ResetForm()
    {
        _sent = false; _error = null;
        _name = _email = _phone = _subject = _message = "";
        _ = RefreshCaptcha();
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_email)
            || string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_message))
        { _error = "Please fill in name, email, subject and message."; return; }
        if (_captcha == null) { _error = "Verification failed to load — please refresh the page."; return; }

        _sending = true;
        var req = new ContactSubmitRequest(_name, _email, _phone, _subject, _message,
                                           _captcha.Token, _captchaAnswer, _website);
        var (ok, error) = await Api.ContactSubmitAsync(req);
        _sending = false;

        if (ok) { _sent = true; }
        else
        {
            _error = error;
            await RefreshCaptcha();   // fresh challenge after a failed attempt
        }
    }

    private record Service(string Key, string Icon, string Title, string Description, string[] Points, string Svg);

    private readonly List<Service> _services = new()
    {
        new("tracking", "usb", "USB & peripheral tracking",
            "Track USB, keyboard, mouse, audio, HID, Bluetooth, storage and display devices the moment they connect or disconnect — with a durable event history that survives restarts.",
            new[] { "USB, input, audio, storage and more", "Instant connect / disconnect events", "Durable history that survives reconnects" },
            SvgTracking),
        new("metrics", "activity", "Live system metrics",
            "See per-device CPU, memory, disk activity and network throughput in real time, sampled from the same performance counters Task Manager uses.",
            new[] { "CPU · RAM · Disk · Network", "Live gauges and sparklines", "Task-Manager-accurate sampling" },
            SvgMetrics),
        new("remote", "remote", "Remote desktop in the browser",
            "Open a full remote desktop session (RDP on Windows, VNC on Linux) straight from the browser — no client to install. Works even for machines behind NAT, thanks to a secure reverse tunnel.",
            new[] { "Clientless RDP in the browser", "Works behind NAT / firewalls", "No inbound ports required" },
            SvgRemote),
        new("tenant", "globe", "Multi-institution management",
            "Each institution admin sees only their own devices; super admins see everything. Roles keep every tenant's data cleanly separated.",
            new[] { "Institution-scoped access", "SuperAdmin / Admin / Viewer roles", "Clean tenant isolation" },
            SvgTenant),
        new("control", "shield","Application control",
            "Block the file types and applications you don't want running on managed machines — stop games or unapproved software from launching, enforced on the device.",
            new[] { "Block-list by extension or name", "Allowed-pattern exceptions", "Enforced on the device" },
            SvgControl),
        new("reports", "file","Reports & audit",
            "Filter device events by institution, device, date, category or user, then print or save to PDF. Every admin action is recorded in the audit log.",
            new[] { "Filter by date / device / user", "Print or save to PDF", "Full administrative audit trail" },
            SvgReports),
    };

    // ── Inline SVG illustrations (dependency-free, theme-blue) ──────────────
    private const string SvgTracking = """
        <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
          <rect x="30" y="30" width="180" height="100" rx="8" fill="#ddeeea" stroke="#0f6e66" stroke-width="2"/>
          <rect x="45" y="46" width="150" height="12" rx="3" fill="#2f8a5b"/>
          <circle cx="60" cy="90" r="10" fill="#0f6e66"/><circle cx="95" cy="90" r="10" fill="#5fb3a8"/>
          <circle cx="130" cy="90" r="10" fill="#2f8a5b"/><circle cx="165" cy="90" r="10" fill="#c2703d"/>
          <rect x="52" y="112" width="136" height="6" rx="3" fill="#d9cfbf"/>
        </svg>
        """;
    private const string SvgMetrics = """
        <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
          <polyline points="20,120 50,90 80,100 110,60 140,80 170,40 210,70" fill="none" stroke="#0f6e66" stroke-width="3"/>
          <polyline points="20,140 50,120 80,130 110,110 140,120 170,95 210,110" fill="none" stroke="#2f8a5b" stroke-width="3"/>
          <circle cx="200" cy="45" r="26" fill="none" stroke="#ddeeea" stroke-width="7"/>
          <circle cx="200" cy="45" r="26" fill="none" stroke="#c2703d" stroke-width="7" stroke-dasharray="120 60" transform="rotate(-90 200 45)"/>
        </svg>
        """;
    private const string SvgRemote = """
        <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
          <rect x="24" y="34" width="90" height="64" rx="6" fill="#ddeeea" stroke="#0f6e66" stroke-width="2"/>
          <rect x="128" y="52" width="88" height="60" rx="6" fill="#e2f1e7" stroke="#2f8a5b" stroke-width="2"/>
          <path d="M116 66 h20 M132 60 l8 6 -8 6" stroke="#c2703d" stroke-width="3" fill="none"/>
          <rect x="52" y="104" width="34" height="6" rx="3" fill="#0f6e66"/>
        </svg>
        """;
    private const string SvgTenant = """
        <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
          <circle cx="120" cy="80" r="30" fill="#0f6e66"/>
          <circle cx="54" cy="52" r="16" fill="#2f8a5b"/><circle cx="186" cy="52" r="16" fill="#5fb3a8"/>
          <circle cx="54" cy="112" r="16" fill="#c2703d"/><circle cx="186" cy="112" r="16" fill="#7a5bc4"/>
          <path d="M120 80 L54 52 M120 80 L186 52 M120 80 L54 112 M120 80 L186 112" stroke="#d9cfbf" stroke-width="2"/>
        </svg>
        """;
    private const string SvgControl = """
        <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
          <path d="M120 28 L172 46 V88 C172 116 148 130 120 138 C92 130 68 116 68 88 V46 Z" fill="#ddeeea" stroke="#0f6e66" stroke-width="2"/>
          <path d="M104 84 l12 12 22 -26" fill="none" stroke="#2f8a5b" stroke-width="5" stroke-linecap="round"/>
        </svg>
        """;
    private const string SvgReports = """
        <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
          <rect x="70" y="26" width="100" height="118" rx="6" fill="#fff" stroke="#0f6e66" stroke-width="2"/>
          <rect x="84" y="44" width="72" height="8" rx="2" fill="#2f8a5b"/>
          <rect x="84" y="62" width="72" height="5" rx="2" fill="#d9cfbf"/>
          <rect x="84" y="74" width="72" height="5" rx="2" fill="#d9cfbf"/>
          <rect x="84" y="86" width="50" height="5" rx="2" fill="#d9cfbf"/>
          <rect x="84" y="104" width="20" height="24" fill="#5fb3a8"/><rect x="110" y="112" width="20" height="16" fill="#0f6e66"/><rect x="136" y="98" width="20" height="30" fill="#2f8a5b"/>
        </svg>
        """;
}
