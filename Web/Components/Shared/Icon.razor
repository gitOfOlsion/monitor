@* Line icons drawn on a 24×24 grid, stroked with currentColor so they follow the text colour. *@
<svg class="pm-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)Path)
</svg>

