@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ServerApiClient Api

<div class="pm-layout">
    <nav class="pm-sidebar">
        <div class="pm-logo">
            <span class="pm-logo-icon">📡</span>
            <span class="pm-logo-text">Peripheral Monitor</span>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">
                <ul class="pm-nav">
                    <li>
                        <NavLink href="/" Match="NavLinkMatch.All">
                            <span class="pm-nav-icon">🏠</span> Dashboard
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/agents">
                            <span class="pm-nav-icon">🖥️</span> Agents
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/events">
                            <span class="pm-nav-icon">📋</span> Events
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/analytics">
                            <span class="pm-nav-icon">📊</span> Analytics
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/metrics">
                            <span class="pm-nav-icon">📈</span> Metrics
                        </NavLink>
                    </li>

                    <!-- Admin links: SuperAdmin + InstitutionAdmin -->
                    <AuthorizeView Roles="SuperAdmin,InstitutionAdmin" Context="adminAuth">
                        <li class="pm-nav-divider"></li>
                        <li class="pm-nav-section">Administration</li>
                        <AuthorizeView Roles="SuperAdmin" Context="featAuth">
                            <li>
                                <NavLink href="/features">
                                    <span class="pm-nav-icon">🎛️</span> Features
                                </NavLink>
                            </li>
                        </AuthorizeView>
                        @if (_reportsEnabled)
                        {
                            <li>
                                <NavLink href="/reports">
                                    <span class="pm-nav-icon">📄</span> Reports
                                </NavLink>
                            </li>
                        }
                        <li>
                            <NavLink href="/users">
                                <span class="pm-nav-icon">👥</span> Users
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="/audit">
                                <span class="pm-nav-icon">📜</span> Audit Log
                            </NavLink>
                        </li>
                    </AuthorizeView>

                    <!-- Institution access: SuperAdmin sees all, InstitutionAdmin sees their own -->
                    <AuthorizeView Roles="SuperAdmin,InstitutionAdmin" Context="instAuth">
                        <li>
                            <NavLink href="/institutions">
                                <span class="pm-nav-icon">🏛️</span>
                                @(instAuth.User.IsInRole("SuperAdmin") ? "Institutions" : "My Institution")
                            </NavLink>
                        </li>
                    </AuthorizeView>
                </ul>

                <div class="pm-sidebar-footer">
                    <div class="pm-user-info">
                        <span class="pm-user-icon">👤</span>
                        <div class="pm-user-detail">
                            <span class="pm-user-name">@auth.User.Identity?.Name</span>
                            <span class="pm-user-role">@auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            @{
                                var inst = auth.User.FindFirst("institution_name")?.Value;
                            }
                            @if (!string.IsNullOrEmpty(inst))
                            { <span class="pm-user-inst">@inst</span> }
                        </div>
                    </div>
                    <a href="/auth/logout" class="pm-logout-btn">🚪 Logout</a>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="pm-main">
        @Body
    </main>
</div>

@code {
    private bool _reportsEnabled;

    protected override async Task OnInitializedAsync()
    {
        // Resolve which feature-gated nav items to show for this user's institution.
        // SuperAdmin's /mine returns all features enabled; InstitutionAdmin gets their
        // institution's resolved flags. Viewers get 403 (caught) and see nothing extra.
        try
        {
            var mine = await Api.GetMyFeaturesAsync();
            _reportsEnabled = mine?.FirstOrDefault(f => f.Key == "reports")?.Effective ?? false;
        }
        catch { _reportsEnabled = false; }
    }
}
