@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ServerApiClient Api
@implements IDisposable

@* Everything in this layout is behind sign-in (or is the 404 page): keep it out of search results. *@
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>

<div class="pm-layout">
    <!-- Mobile top bar with hamburger (hidden on desktop via CSS) -->
    <div class="pm-mobile-bar">
        <button class="pm-hamburger" @onclick="ToggleSidebar" aria-label="Open menu"><Icon Name="menu" Size="20" /></button>
        <span class="pm-mobile-title"><span class="pm-brand-mark"><Icon Name="logo" Size="18" /></span> Peripheral Monitor</span>
    </div>

    @if (_sidebarOpen)
    {
        <div class="pm-sidebar-backdrop" @onclick="CloseSidebar"></div>
    }

    <nav class="pm-sidebar @(_sidebarOpen ? "pm-sidebar-open" : "")" aria-label="Main">
        <a class="pm-logo" href="/dashboard">
            <span class="pm-brand-mark"><Icon Name="logo" Size="20" /></span>
            <span class="pm-logo-text">
                <span class="pm-logo-name">Peripheral Monitor</span>
                <span class="pm-logo-sub">Device visibility hub</span>
            </span>
        </a>

        <AuthorizeView>
            <Authorized Context="auth">
                <ul class="pm-nav">
                    <li><NavLink href="/dashboard" Match="NavLinkMatch.All"><Icon Name="home" /> Dashboard</NavLink></li>
                    <li><NavLink href="/agents"><Icon Name="monitor" /> Agents</NavLink></li>
                    <li><NavLink href="/events"><Icon Name="events" /> Events</NavLink></li>
                    <li><NavLink href="/analytics"><Icon Name="chart" /> Analytics</NavLink></li>
                    <li><NavLink href="/metrics"><Icon Name="activity" /> Metrics</NavLink></li>

                    <!-- Admin links: SuperAdmin + InstitutionAdmin -->
                    <AuthorizeView Roles="SuperAdmin,InstitutionAdmin" Context="adminAuth">
                        <li class="pm-nav-divider"></li>
                        <li class="pm-nav-section">Administration</li>
                        <li><NavLink href="/features"><Icon Name="sliders" /> Features</NavLink></li>
                        @if (_reportsEnabled)
                        {
                            <li><NavLink href="/reports"><Icon Name="file" /> Reports</NavLink></li>
                        }
                        <li><NavLink href="/users"><Icon Name="users" /> Users</NavLink></li>
                        <li><NavLink href="/audit"><Icon Name="history" /> Audit Log</NavLink></li>
                        <AuthorizeView Roles="SuperAdmin" Context="msgAuth">
                            <li>
                                <NavLink href="/messages">
                                    <Icon Name="mail" /> Messages
                                    @if (_unreadMessages > 0)
                                    { <span class="pm-nav-badge">@_unreadMessages</span> }
                                </NavLink>
                            </li>
                        </AuthorizeView>
                    </AuthorizeView>

                    <!-- Institution access: SuperAdmin sees all, InstitutionAdmin sees their own -->
                    <AuthorizeView Roles="SuperAdmin,InstitutionAdmin" Context="instAuth">
                        <li>
                            <NavLink href="/institutions">
                                <Icon Name="building" />
                                @(instAuth.User.IsInRole("SuperAdmin") ? "Institutions" : "My Institution")
                            </NavLink>
                        </li>
                    </AuthorizeView>
                </ul>

                <div class="pm-sidebar-footer">
                    @{
                        var name = auth.User.Identity?.Name ?? "";
                        var role = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        var inst = auth.User.FindFirst("institution_name")?.Value;
                    }
                    <div class="pm-user-info">
                        <span class="pm-user-icon" aria-hidden="true">@(name.Length > 0 ? name[..1] : "?")</span>
                        <div class="pm-user-detail">
                            <span class="pm-user-name">@name</span>
                            <span class="pm-user-role">@RoleLabel(role)</span>
                            @if (!string.IsNullOrEmpty(inst))
                            { <span class="pm-user-inst">@inst</span> }
                        </div>
                    </div>
                    <a href="/auth/logout" class="pm-logout-btn"><Icon Name="logout" Size="16" /> Sign out</a>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="pm-main">
        <div class="pm-main-inner">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _reportsEnabled;
    private bool _sidebarOpen;
    private int  _unreadMessages;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar()  => _sidebarOpen = false;

    private static string RoleLabel(string? role) => role switch
    {
        "SuperAdmin"       => "Super admin",
        "InstitutionAdmin" => "Institution admin",
        null or ""         => "",
        _                  => role,
    };

    protected override void OnInitialized()
    {
        // Close the mobile drawer whenever the route changes
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_sidebarOpen) { _sidebarOpen = false; InvokeAsync(StateHasChanged); }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    protected override async Task OnInitializedAsync()
    {
        // Resolve which feature-gated nav items to show for this user's institution.
        // SuperAdmin's /mine returns all features enabled; InstitutionAdmin gets their
        // institution's resolved flags. Viewers get 403 (caught) and see nothing extra.
        try
        {
            var mine = await Api.GetMyFeaturesAsync();
            _reportsEnabled = mine?.FirstOrDefault(f => f.Key == "reports")?.Effective ?? false;
        }
        catch { _reportsEnabled = false; }

        // Unread contact-message badge (SuperAdmin only; returns 0 for everyone else).
        _unreadMessages = await Api.GetContactUnreadCountAsync();
    }
}
