@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="pm-layout">
    <nav class="pm-sidebar">
        <div class="pm-logo">
            <span class="pm-logo-icon">📡</span>
            <span class="pm-logo-text">Peripheral Monitor</span>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">
                <ul class="pm-nav">
                    <li>
                        <NavLink href="/" Match="NavLinkMatch.All">
                            <span class="pm-nav-icon">🏠</span> Dashboard
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/agents">
                            <span class="pm-nav-icon">🖥️</span> Agents
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/events">
                            <span class="pm-nav-icon">📋</span> Events
                        </NavLink>
                    </li>

                    <!-- SuperAdmin-only links -->
                    <AuthorizeView Roles="SuperAdmin">
                        <li class="pm-nav-divider"></li>
                        <li class="pm-nav-section">Administration</li>
                        <li>
                            <NavLink href="/institutions">
                                <span class="pm-nav-icon">🏛️</span> Institutions
                            </NavLink>
                        </li>
                    </AuthorizeView>
                </ul>

                <div class="pm-sidebar-footer">
                    <div class="pm-user-info">
                        <span class="pm-user-icon">👤</span>
                        <span>@auth.User.Identity?.Name</span>
                    </div>
                    <a href="/auth/logout" class="pm-logout-btn">🚪 Logout</a>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="pm-main">
        @Body
    </main>
</div>
