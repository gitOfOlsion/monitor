<Project>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Change DotNetVersion to upgrade the entire solution.
       All other version properties are pinned independently below.
       ═══════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <DotNetVersion>10.0</DotNetVersion>
  </PropertyGroup>

  <!-- Shared compiler settings -->
  <PropertyGroup>
    <TargetFramework>net$(DotNetVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!-- ── Version properties ─────────────────────────────────────────────
       csproj files reference these as Version="$(PropertyName)".
       Upgrade a library → change the number here → all projects get it.
  ──────────────────────────────────────────────────────────────────────── -->
  <PropertyGroup>
    <!-- ASP.NET Core / EF Core / Extensions — track .NET major -->
    <AspNetCoreVersion>$(DotNetVersion).0</AspNetCoreVersion>
    <EfCoreVersion>$(DotNetVersion).0</EfCoreVersion>
    <ExtensionsVersion>$(DotNetVersion).0</ExtensionsVersion>

    <!-- Npgsql — own cadence, does NOT always match .NET version -->
    <NpgsqlEfVersion>10.0.0</NpgsqlEfVersion>

    <!-- JWT — own cadence -->
    <JwtVersion>8.4.0</JwtVersion>

    <!-- Serilog — own cadence per package -->
    <SerilogAspNetCoreVersion>9.0.0</SerilogAspNetCoreVersion>
    <SerilogHostingVersion>8.0.0</SerilogHostingVersion>
    <SerilogConsoleVersion>6.0.0</SerilogConsoleVersion>
    <SerilogFileVersion>6.0.0</SerilogFileVersion>
    <SerilogSeqVersion>8.0.0</SerilogSeqVersion>
    <SerilogConfigVersion>9.0.0</SerilogConfigVersion>
    <SerilogEnvVersion>3.0.0</SerilogEnvVersion>
    <SerilogThreadVersion>4.0.0</SerilogThreadVersion>
  </PropertyGroup>

</Project>
